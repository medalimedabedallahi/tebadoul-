APP_NAME=Badal
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8098
FRONTEND_URL=http://localhost:8098

# Proxies de confiance (IP/CIDR separes par des virgules, ou * derriere un load balancer).
# Laisser vide en local : sinon X-Forwarded-For pourrait etre falsifie et contourner les limites par IP.
TRUSTED_PROXIES=

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=badal
DB_USERNAME=badal
DB_PASSWORD=badal_local_password
FORWARD_DB_PORT=54329

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=badal_cache

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=badal_local_password
REDIS_PORT=6379
FORWARD_REDIS_PORT=6389

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@badal.test"
MAIL_FROM_NAME="${APP_NAME}"
FORWARD_MAIL_PORT=1026
FORWARD_MAILPIT_PORT=8026

APP_PORT=8098

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
