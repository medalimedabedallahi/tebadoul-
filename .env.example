APP_NAME=Badal
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8098
FRONTEND_URL=http://localhost:8098

# Proxies de confiance (IP/CIDR separes par des virgules, ou * derriere un load balancer).
# Laisser vide en local : sinon X-Forwarded-For pourrait etre falsifie et contourner les limites par IP.
TRUSTED_PROXIES=

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# Indicatif telephonique (chiffres, sans +) applique aux numeros saisis sans indicatif international.
APP_PHONE_COUNTRY_CODE=222

# Jetons d'API Sanctum : duree de vie en minutes (10080 = 7 jours) et prefixe reperable par les scanners de secrets.
SANCTUM_EXPIRATION=10080
SANCTUM_TOKEN_PREFIX=bdl_
# Hotes (avec port) recevant l'authentification par cookie (SPA). Vide : hotes de APP_URL et FRONTEND_URL seulement.
SANCTUM_STATEFUL_DOMAINS=

# Codes a usage unique (verification de contact, reinitialisation du mot de passe) :
# nombre de chiffres (4 a 9), validite en minutes, essais errones avant verrouillage du code.
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Envoi de SMS : `log` (developpement, journal masque, jamais le code) ou `null` (aucun envoi).
# Aucun fournisseur reel n'est integre : toute autre valeur empeche le demarrage de l'application.
SMS_DRIVER=log

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Conteneurs : les journaux vont sur stderr (docker logs / collecte centralisee), pas dans storage/logs.
# Hors Docker, ou pour utiliser `php artisan pail`, passer LOG_STACK=single.
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=badal
DB_USERNAME=badal
# Placeholder : remplacer par une valeur aleatoire (ex. `openssl rand -base64 24`). compose.yaml refuse un mot de passe vide.
DB_PASSWORD=change-me
# En production : DB_SSLMODE=require (voir .env.production.example).
# DB_SSLMODE=prefer
FORWARD_DB_PORT=54329

# Sessions dans Redis (instance de developpement unique). En production, voir .env.production.example.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=badal_cache
# Store Laravel dedie aux compteurs de limitation (throttle) et aux cles d'idempotence : doit vivre sur une instance
# Redis en noeviction pour ne jamais etre evince sous pression memoire. Vide en developpement (instance Redis unique,
# deja en noeviction : voir compose.yaml) = store par defaut. En production : redis-persistent (.env.production.example).
# CACHE_LIMITER_STORE=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
# Placeholder : remplacer par une valeur aleatoire. Ce mot de passe est aussi celui du conteneur Redis (compose.yaml).
REDIS_PASSWORD=change-me
REDIS_PORT=6379
FORWARD_REDIS_PORT=6389
# Cache Redis separe (production : service redis-cache). Vide en developpement : le cache utilise REDIS_HOST / REDIS_PASSWORD (base 1).
# REDIS_CACHE_HOST=
# REDIS_CACHE_PASSWORD=
# REDIS_CACHE_PORT=6379
# REDIS_CACHE_DB=1

# Base Redis dediee au store CACHE_LIMITER_STORE (limitation/idempotence), sur l'instance noeviction. Sans objet en
# developpement (instance unique, deja noeviction). En production : base 2 sur redis-queue (.env.production.example).
# REDIS_PERSISTENT_DB=

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@badal.test"
MAIL_FROM_NAME="${APP_NAME}"
FORWARD_MAIL_PORT=1026
FORWARD_MAILPIT_PORT=8026

APP_PORT=8098
# Nginx n'ecoute que sur la boucle locale par defaut ; 0.0.0.0 pour l'exposer sur le reseau local.
APP_BIND_ADDRESS=127.0.0.1

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Matching (ADR 0001) : desactive tant que les regles de compatibilite ne sont pas validees par les experts.
# Apres activation : php artisan matching:recompute
MATCHING_ENABLED=false
MATCHING_AVAILABILITY_TOLERANCE_DAYS=0
MATCHING_INVITATION_TTL_DAYS=14

VITE_APP_NAME="${APP_NAME}"
