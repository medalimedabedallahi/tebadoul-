# Modele pour un VPS Hostinger utilisant :
#   compose.prod.yaml + compose.hostinger.yaml
# Copier en .env.production sur le VPS, puis remplacer toutes les valeurs change-me.
# Les secrets restent dans /etc/badal/secrets et ne doivent jamais etre ajoutes ici.

BADAL_IMAGE=ghcr.io/change-me/badal-app
BADAL_NGINX_IMAGE=ghcr.io/change-me/badal-nginx
BADAL_TAG=sha-0000000
BADAL_SECRETS_DIR=/etc/badal/secrets
BADAL_NETWORK_SUBNET=172.29.20.0/24
BADAL_NGINX_IP=172.29.20.10
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
REDIS_QUEUE_MAXMEMORY=512mb
REDIS_CACHE_MAXMEMORY=256mb

APP_NAME=Badal
APP_ENV=production
APP_DEBUG=false
APP_URL=https://change-me.example
FRONTEND_URL=https://change-me.example
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
BCRYPT_ROUNDS=12

APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

TRUSTED_PROXIES=172.29.20.10

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# PostgreSQL du compose Hostinger, uniquement accessible sur le reseau prive Docker.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=badal
DB_USERNAME=badal_app
DB_SSLMODE=disable

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=badal_cache
CACHE_LIMITER_STORE=redis-persistent
REDIS_PERSISTENT_DB=2
BROADCAST_CONNECTION=log
REDIS_CLIENT=phpredis
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=change-me
MAIL_PORT=587
MAIL_USERNAME=change-me
MAIL_FROM_ADDRESS=no-reply@change-me.example
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local

MATCHING_ENABLED=false
MATCHING_AVAILABILITY_TOLERANCE_DAYS=0
MATCHING_INVITATION_TTL_DAYS=14

VITE_APP_NAME="${APP_NAME}"
