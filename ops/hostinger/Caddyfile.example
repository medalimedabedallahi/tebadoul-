# Frontal TLS du VPS Hostinger : Caddy installe sur l'hote (paquet officiel, service systemd `caddy`).
#
#   sudo cp ops/hostinger/Caddyfile.example /etc/caddy/Caddyfile   # puis remplacer tebadoul.example
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# Caddy obtient et renouvelle seul le certificat Let's Encrypt (DNS A pointe vers le VPS, ports 80 et 443 ouverts
# dans le pare-feu Hostinger) et redirige HTTP vers HTTPS. Par defaut, reverse_proxy IGNORE les en-tetes
# X-Forwarded-* recus du client et pose les siens (For, Proto, Host) : c'est ce qu'exigent
# docker/nginx/production.conf (set_real_ip_from 172.29.20.1) et TRUSTED_PROXIES. Ne pas definir trusted_proxies
# ici tant qu'aucun CDN n'est place devant Caddy.

www.tebadoul.example {
	redir https://tebadoul.example{uri} permanent
}

tebadoul.example {
	# Meme limite que client_max_body_size du Nginx de l'application (bannieres, envois Livewire).
	request_body {
		max_size 10MB
	}

	# Nginx de la pile compose.prod.yaml, publie uniquement sur la boucle locale (APP_BIND_ADDRESS / APP_PORT).
	reverse_proxy 127.0.0.1:8080

	log {
		output file /var/log/caddy/tebadoul-access.log {
			roll_size 50MiB
			roll_keep 10
		}
	}
}
