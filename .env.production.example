# Modele d'environnement de PRODUCTION (compose.prod.yaml). Copier en .env.production (non versionne).
#
# AUCUN secret dans ce fichier : APP_KEY, DB_PASSWORD, mots de passe Redis, MAIL_PASSWORD et
# AWS_SECRET_ACCESS_KEY sont fournis par des Docker secrets (fichiers dans BADAL_SECRETS_DIR, voir ops/README.md).
# Ne jamais definir ces variables ici : l'entrypoint charge NOM_FILE, et une valeur en clair serait visible via `docker inspect`.

# --- Compose (interpolation, pas transmis a Laravel) ---
BADAL_IMAGE=ghcr.io/example-org/badal-app
BADAL_NGINX_IMAGE=ghcr.io/example-org/badal-nginx
# Tag immuable par commit (ex. sha-3d3c42e...) ; jamais `latest`. Positionne par ops/deploy.sh.
BADAL_TAG=sha-0000000
BADAL_SECRETS_DIR=/etc/badal/secrets
# Sous-reseau Docker fixe (compose.prod.yaml : networks.badal.ipam).
BADAL_NETWORK_SUBNET=172.29.20.0/24
# IP fixe attribuee au conteneur nginx sur ce sous-reseau (compose.prod.yaml : networks.badal.ipv4_address).
# TRUSTED_PROXIES (section Application ci-dessous) DOIT etre strictement egal a cette valeur : c'est le seul
# saut que l'application PHP doit considerer comme un proxy de confiance (et non tout le sous-reseau).
BADAL_NGINX_IP=172.29.20.10
# Adresse/port sur lesquels le frontal TLS joint Nginx.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
REDIS_QUEUE_MAXMEMORY=512mb
REDIS_CACHE_MAXMEMORY=256mb

# --- Application ---
APP_NAME=Badal
APP_ENV=production
APP_DEBUG=false
APP_URL=https://badal.example.org
FRONTEND_URL=https://badal.example.org
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
BCRYPT_ROUNDS=12

# Mode maintenance partage entre conteneurs (le mode `file` ne concernerait qu'un seul conteneur).
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

# Envoi de SMS : aucun fournisseur reel n'est encore integre (decision produit en attente). `change-me` n'est
# PAS un pilote valide : l'application refuse de demarrer tant qu'un vrai fournisseur n'a pas ete choisi et code
# cote application (voir app/Providers/AppServiceProvider.php). Ne jamais mettre `log` ici : le backend doit
# refuser ce pilote en production/staging sauf SMS_ALLOW_LOG_DRIVER=true.
SMS_DRIVER=change-me
SMS_ALLOW_LOG_DRIVER=false

# Nginx est le seul pair direct de PHP-FPM : ne faire confiance qu'a son IP fixe (BADAL_NGINX_IP ci-dessus),
# jamais a tout le sous-reseau Docker (qui inclut la passerelle .1 et d'autres conteneurs). Le frontal TLS doit
# ecraser les en-tetes X-Forwarded-* recus du client ; Nginx normalise ensuite X-Forwarded-For avant PHP-FPM
# (voir docker/nginx/production.conf : set_real_ip_from / real_ip_header / real_ip_recursive). Ne jamais utiliser `*`.
TRUSTED_PROXIES=172.29.20.10

# --- Journaux : stderr uniquement (docker logs, collecte centralisee, rotation json-file) ---
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# --- Base de donnees : PostgreSQL externe, TLS obligatoire. DB_PASSWORD -> secret db_password ---
DB_CONNECTION=pgsql
DB_HOST=db.example.internal
DB_PORT=5432
DB_DATABASE=badal
DB_USERNAME=badal_app
DB_SSLMODE=require

# --- Sessions (Redis queue, persistant) : cookies chiffres, HTTPS uniquement ---
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# --- Queue et cache ---
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=badal_cache
BROADCAST_CONNECTION=log

# Store Laravel dedie aux compteurs de limitation (throttle) et aux cles d'idempotence, sur l'instance Redis
# noeviction (redis-queue) plutot que sur redis-cache (allkeys-lru : ces cles ne doivent jamais etre evincees
# silencieusement). base 2 = distincte de la base 0 (queue/jobs) et de la base 1 (sessions par defaut) sur la
# meme instance. HYPOTHESE A ALIGNER AVEC LE BACKEND : noms exacts du store Laravel et de la variable de base
# Redis (voir config/database.php et config/cache.php une fois le store "persistent" ajoute cote application).
CACHE_LIMITER_STORE=redis-persistent
REDIS_PERSISTENT_DB=2

# --- Redis : REDIS_HOST / REDIS_CACHE_HOST et les mots de passe sont poses par compose.prod.yaml ---
REDIS_CLIENT=phpredis
REDIS_PORT=6379

# --- Courriel (MAIL_PASSWORD -> secret mail_password) ---
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.example.org
MAIL_PORT=587
MAIL_USERNAME=change-me
MAIL_FROM_ADDRESS="no-reply@badal.example.org"
MAIL_FROM_NAME="${APP_NAME}"

# --- Fichiers : S3 (AWS_SECRET_ACCESS_KEY -> secret aws_secret_access_key) ---
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=change-me
AWS_DEFAULT_REGION=eu-west-3
AWS_BUCKET=badal-example-bucket
AWS_USE_PATH_STYLE_ENDPOINT=false

# Matching (ADR 0001) : desactive tant que les regles de compatibilite ne sont pas validees par les experts.
# Apres activation : php artisan matching:recompute
MATCHING_ENABLED=false
MATCHING_AVAILABILITY_TOLERANCE_DAYS=0
MATCHING_INVITATION_TTL_DAYS=14

VITE_APP_NAME="${APP_NAME}"
